name: Vault Options
on:
  schedule:
    - cron: "37 * * * 1-5"
  workflow_dispatch:
    inputs:
      mode:
        description: "full = scan now · auto = what the timer uses"
        default: "full"
        type: choice
        options: [full, auto]
permissions:
  contents: write
  pages: write
  id-token: write
concurrency:
  group: pages
  cancel-in-progress: false
jobs:
  scan:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deploy.outputs.page_url }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Run Vault Options
        id: bot
        env:
          ALPACA_KEY_ID: ${{ secrets.ALPACA_KEY_ID }}
          ALPACA_SECRET_KEY: ${{ secrets.ALPACA_SECRET_KEY }}
          ALPACA_ENV: ${{ vars.ALPACA_ENV }}
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
        run: python vault_options.py --out site/index.html --mode "${{ inputs.mode || 'auto' }}"
      - name: Save bot memory
        run: |
          git config user.name "vault-options"
          git config user.email "vault-options@users.noreply.github.com"
          git add options_state.json 2>/dev/null || true
          git diff --cached --quiet || (git commit -m "Update state" && git pull --rebase && git push)
      - if: steps.bot.outputs.deploy == 'true'
        uses: actions/configure-pages@v5
      - if: steps.bot.outputs.deploy == 'true'
        uses: actions/upload-pages-artifact@v3
        with:
          path: site
      - if: steps.bot.outputs.deploy == 'true'
        id: deploy
        uses: actions/deploy-pages@v4
